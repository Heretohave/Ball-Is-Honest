# Copy to .env.local for local dev, and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# See README.md "Google sign-in setup" for how to get these values.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# http://localhost:3000 locally; https://www.ballishonest.com in production
NEXTAUTH_URL=
